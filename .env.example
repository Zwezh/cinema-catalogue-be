NODE_ENV=development
PORT=3000
TURSO_DATABASE_URL=file:./cinema.db
# TURSO_AUTH_TOKEN=replace-with-remote-database-token
JWT_KEY=replace-with-a-random-secret-of-at-least-32-bytes
CORS_ORIGINS=http://localhost:4200
DATABASE_AUTO_MIGRATE=true
TRUST_PROXY_HOPS=0
KINOPOISK_API_TOKEN=replace-with-provider-key

# Optional local catalogue reads for a remote primary and persistent Node host.
# TURSO_REPLICA_PATH=.tmp/read-replica/catalog.sqlite
TURSO_REPLICA_SYNC_MS=30000

# Use lax with a same-site/same-origin API; none is an explicit cross-site HTTPS opt-in.
REFRESH_COOKIE_SAMESITE=lax
